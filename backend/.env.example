# ===== 单用户访问口令 =====
# 所有 API 请求都必须在 Header 带：Authorization: Bearer <这里的值>
# 上线前务必改成你自己的强口令！
API_TOKEN=change_me_to_a_strong_token

# ===== 数据库位置 =====
# 本地默认即可。云服务器(Render 等)建议指向持久磁盘，例如 sqlite:////data/health.db
DATABASE_URL=sqlite:///./health.db

# ===== 允许跨域的前端域名（CORS）=====
# 本地开发用 * ；上线后建议改成你的真实域名，如 https://xxx.onrender.com
CORS_ORIGINS=*

# ===== 服务端口 =====
PORT=8000
